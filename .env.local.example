# Supabase — found in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Service role key — Project Settings → API. SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used to build invite accept links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — used to send invite emails. If unset, invite links are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="Gridiron League <invites@yourdomain.com>"
